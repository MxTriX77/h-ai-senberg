# Copy to `.env` to override defaults. Every variable is optional; defaults are shown.
# Variables set in the real environment win over this file.

# App address
APP_HOST=127.0.0.1
APP_PORT=8000

# Model profile: config/<name>.yaml merged over config/config.yaml (unset = defaults)
# MODEL_PROFILE=

# Reasoner backend (any OpenAI-compatible API)
API_BASE_URL=http://127.0.0.1:8080/v1
# Leave empty for local llama-server; set for cloud backends
API_KEY=
MODEL_ID=qwen3.5-9b
# Sampling seed sent with every request, for eval A/Bs (empty = none)
EVAL_SEED=

# Where downloads and indexes live
DATA_DIR=data
# Knowledge the tools read, one of retrieval.knowledge_sets: base = Layer 1 store only; extended = + literature
KNOWLEDGE=base

# Local llama-server launcher
# false = don't start llama-server (use one already running, or a remote backend)
LLAMA_SERVER_ENABLED=true
LLAMA_SERVER_EXE=llama-server
MODEL_PATH=models/Qwen3.5-9B-Q4_K_M.gguf
# Machine-specific launch settings (raise on bigger GPUs / cloud boxes)
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
CTX_SIZE=16384
# Layers on the GPU (99 = all)
GPU_LAYERS=99
LLAMA_THREADS=8
# MoE models (profiles): expert layers kept in RAM instead of the GPU
N_CPU_MOE=32
# Cap on thinking tokens per reasoner call: llama-server's reasoning-budget and the top of
# reasoning_policy.thinking_budget (default 4096; the 35B profile 8192)
REASONING_BUDGET=4096
# llama-server's own log file (empty = console only)
LLAMA_LOG_FILE=
# Vulkan device index for the GPU (1 = RTX 4050 on this laptop)
LLAMA_VK_DEVICES=1

# Use another config file
# HAISENBERG_CONFIG=config/config.yaml
